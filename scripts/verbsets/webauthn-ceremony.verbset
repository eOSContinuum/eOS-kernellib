# webauthn operator verb -- the ceremony daemon driven end-to-end on a
# module-bearing boot with foreign-generated vectors (regenerate with
# scripts/gen-webauthn-vectors.py; do not edit by hand):
#   LPC_EXT_CRYPTO=<crypto> DGD_BIN=<dgd> scripts/drive-verbs-smoke.sh \
#       scripts/verbsets/webauthn-ceremony.verbset
# Covers: rp configuration, TOFU registration minting an identity,
# assertion verification updating signCount and surfacing the flags
# byte, the signCount replay refusal, the backup-eligible (synced
# passkey) counter exemption, re-registration of a bound credential
# refused, an unknown credential refused, and the System-tier gate
# refusing a console caller.

# point the ceremony daemon at the vectors' rp
cmd: webauthn rpid localhost
expect: webauthn: rpId localhost

cmd: webauthn origin https://localhost:8443
expect: webauthn: origin https://localhost:8443

cmd: webauthn
expect: webauthn: rpId localhost
expect: webauthn: origin https://localhost:8443
expect: crypto module: present

# TOFU registration mints an identity bound to the credential
cmd: webauthn register AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8 eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiQUFFQ0F3UUZCZ2NJQ1FvTERBME9EeEFSRWhNVUZSWVhHQmthR3h3ZEhoOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YViUSZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NBAAAABaChoqOkpaanqKmqq6ytrq8AEBAREhMUFRYXGBkaGxwdHh-lAQIDJiABIVggutAZB12vK3MHpUMNTzuwrmsu_Ufdl88vrl7-i3NTkrMiWCA4FUY_svOcGa_UNWz6IGbHLJHDNuS-q5R4CNhF67VhOQ
expect: webauthn: registered identity:[0-9a-f-]+
capture: uuid registered identity:([0-9a-f-]+)

# the same credential cannot register twice (never bare TOFU re-bind)
cmd: webauthn register AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8 eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiQUFFQ0F3UUZCZ2NJQ1FvTERBME9EeEFSRWhNVUZSWVhHQmthR3h3ZEhoOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YViUSZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NBAAAABaChoqOkpaanqKmqq6ytrq8AEBAREhMUFRYXGBkaGxwdHh-lAQIDJiABIVggutAZB12vK3MHpUMNTzuwrmsu_Ufdl88vrl7-i3NTkrMiWCA4FUY_svOcGa_UNWz6IGbHLJHDNuS-q5R4CNhF67VhOQ
expect: identity: credential already bound

# assertion verifies, advances signCount (5 at registration -> 6), and
# surfaces the assertion's flags byte (this vector is UP-only, 0x01)
cmd: webauthn authenticate ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8 EBESExQVFhcYGRobHB0eHw eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiSUNFaUl5UWxKaWNvS1NvckxDMHVMekF4TWpNME5UWTNPRGs2T3p3OVBqOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MBAAAABg MEUCIQCO5RCL6vigEXTwvYsUduOLitc5s61iGG5Ls2BV8IzGsQIgVlDlmGTte__j0tiTChI0-X7pZYka9R8TBXUY-ZkSkaM
expect: webauthn: authenticated identity:%{uuid} signCount 6 flags 0x01

# replaying the same assertion is refused (6 is not greater than 6)
cmd: webauthn authenticate ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8 EBESExQVFhcYGRobHB0eHw eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiSUNFaUl5UWxKaWNvS1NvckxDMHVMekF4TWpNME5UWTNPRGs2T3p3OVBqOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MBAAAABg MEUCIQCO5RCL6vigEXTwvYsUduOLitc5s61iGG5Ls2BV8IzGsQIgVlDlmGTte__j0tiTChI0-X7pZYka9R8TBXUY-ZkSkaM
expect: webauthn: signCount replay

# an unknown credential is refused
cmd: webauthn authenticate ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8 AAAAAAAAAAAAAAAAAAAAAA eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiSUNFaUl5UWxKaWNvS1NvckxDMHVMekF4TWpNME5UWTNPRGs2T3p3OVBqOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MBAAAABg MEUCIQCO5RCL6vigEXTwvYsUduOLitc5s61iGG5Ls2BV8IzGsQIgVlDlmGTte__j0tiTChI0-X7pZYka9R8TBXUY-ZkSkaM
expect: webauthn: unknown credential

# a synced passkey (BE|BS) registers with counter 0
cmd: webauthn register BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiQlFVRkJRVUZCUVVGQlFVRkJRVUZCUVVGQlFVRkJRVUZCUVVGQlFVRkJRVSIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YViUSZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NZAAAAAAAAAAAAAAAAAAAAAAAAAAAAEHBxcnN0dXZ3eHl6e3x9fn-lAQIDJiABIVggEIDrijQ5639PuFKvKqO88rysuu1L5kNfNUlqT1IvqxEiWCAWc5oMchhqxhdujXBDvzN1kgXcEX9w3HrAGGsU1H9VrA
expect: webauthn: registered identity:[0-9a-f-]+
capture: uuid2 registered identity:([0-9a-f-]+)

# one copy asserts counter 7 (flags UP|BE|BS = 0x19)
cmd: webauthn authenticate BgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgY cHFyc3R1dnd4eXp7fH1-fw eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiQmdZR0JnWUdCZ1lHQmdZR0JnWUdCZ1lHQmdZR0JnWUdCZ1lHQmdZR0JnWSIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MZAAAABw MEQCIFmWtbkE89-8ClHoCiW0d14X8N6a4nkUBkSnL8pw3tU-AiA2Rrg-r_7XDWYscWeE8Zr6yDauXWi4bqfhtamdNsEZhA
expect: webauthn: authenticated identity:%{uuid2} signCount 7 flags 0x19

# another copy still reports 0: backup-eligible is exempt from the
# strictly-increasing counter policy, so this is accepted, not a
# permanent lockout
cmd: webauthn authenticate BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc cHFyc3R1dnd4eXp7fH1-fw eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiQndjSEJ3Y0hCd2NIQndjSEJ3Y0hCd2NIQndjSEJ3Y0hCd2NIQndjSEJ3YyIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MZAAAAAA MEUCIAatHkCqHLvfY3FkYf4rDbqJjpd9fDMFLq9HuAFieLCeAiEA17znytxkqqGzB8EF1sCqum9-vJ83pFfYpZJbbKiBrms
expect: webauthn: authenticated identity:%{uuid2} signCount 0 flags 0x19

# the System-tier API refuses a console caller
cmd: code "/usr/System/sys/webauthnd"->issue_challenge()
expect: Error: Access denied

# the record carries the passkey row with the advanced counter
cmd: identity show %{uuid}
expect: credentials: 1
expect: passkey signCount 6
