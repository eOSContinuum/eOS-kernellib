# webauthn operator verb -- the ceremony daemon driven end-to-end on a
# module-bearing boot with foreign-generated vectors (regenerate with
# scripts/gen-webauthn-vectors.py; do not edit by hand):
#   LPC_EXT_CRYPTO=<crypto> DGD_BIN=<dgd> scripts/drive-verbs-smoke.sh \
#       scripts/verbsets/webauthn-ceremony.verbset
# Covers: rp configuration, TOFU registration minting an identity,
# assertion verification updating signCount, the signCount replay
# refusal, re-registration of a bound credential refused, an unknown
# credential refused, and the System-tier gate refusing a console
# caller.

# point the ceremony daemon at the vectors' rp
cmd: webauthn rpid localhost
expect: webauthn: rpId localhost

cmd: webauthn origin https://localhost:8443
expect: webauthn: origin https://localhost:8443

cmd: webauthn
expect: webauthn: rpId localhost
expect: webauthn: origin https://localhost:8443
expect: crypto module: present

# TOFU registration mints an identity bound to the credential
cmd: webauthn register AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8 eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiQUFFQ0F3UUZCZ2NJQ1FvTERBME9EeEFSRWhNVUZSWVhHQmthR3h3ZEhoOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YViUSZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NBAAAABaChoqOkpaanqKmqq6ytrq8AEBAREhMUFRYXGBkaGxwdHh-lAQIDJiABIVggl0VfoQFKer-31K33d1t63ywLJ5gDDeYf9A4P0q4TndgiWCBXs229ioHj_Pn0f2O55_LL3LgP4DmJxbPkjuustD-4QA
expect: webauthn: registered identity:[0-9a-f-]+
capture: uuid registered identity:([0-9a-f-]+)

# the same credential cannot register twice (never bare TOFU re-bind)
cmd: webauthn register AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8 eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiQUFFQ0F3UUZCZ2NJQ1FvTERBME9EeEFSRWhNVUZSWVhHQmthR3h3ZEhoOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YViUSZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NBAAAABaChoqOkpaanqKmqq6ytrq8AEBAREhMUFRYXGBkaGxwdHh-lAQIDJiABIVggl0VfoQFKer-31K33d1t63ywLJ5gDDeYf9A4P0q4TndgiWCBXs229ioHj_Pn0f2O55_LL3LgP4DmJxbPkjuustD-4QA
expect: identity: credential already bound

# assertion verifies, advances signCount (5 at registration -> 6), and
# surfaces the assertion's flags byte (this vector is UP-only, 0x01)
cmd: webauthn authenticate ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8 EBESExQVFhcYGRobHB0eHw eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiSUNFaUl5UWxKaWNvS1NvckxDMHVMekF4TWpNME5UWTNPRGs2T3p3OVBqOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MBAAAABg MEQCIFoEmCoTlj9MV6mLr2Fqx69r0VmWgVrEm4XyX0ATFR8oAiBuIsNCdscPLVTiONPWmzos7KKaTNJnRiXNGceiCQdvRA
expect: webauthn: authenticated identity:%{uuid} signCount 6 flags 0x01

# replaying the same assertion is refused (6 is not greater than 6)
cmd: webauthn authenticate ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8 EBESExQVFhcYGRobHB0eHw eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiSUNFaUl5UWxKaWNvS1NvckxDMHVMekF4TWpNME5UWTNPRGs2T3p3OVBqOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MBAAAABg MEQCIFoEmCoTlj9MV6mLr2Fqx69r0VmWgVrEm4XyX0ATFR8oAiBuIsNCdscPLVTiONPWmzos7KKaTNJnRiXNGceiCQdvRA
expect: webauthn: signCount replay

# an unknown credential is refused
cmd: webauthn authenticate ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8 AAAAAAAAAAAAAAAAAAAAAA eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiSUNFaUl5UWxKaWNvS1NvckxDMHVMekF4TWpNME5UWTNPRGs2T3p3OVBqOCIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MBAAAABg MEQCIFoEmCoTlj9MV6mLr2Fqx69r0VmWgVrEm4XyX0ATFR8oAiBuIsNCdscPLVTiONPWmzos7KKaTNJnRiXNGceiCQdvRA
expect: webauthn: unknown credential

# a synced passkey (BE|BS) registers with counter 0
cmd: webauthn register BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiQlFVRkJRVUZCUVVGQlFVRkJRVUZCUVVGQlFVRkJRVUZCUVVGQlFVRkJRVSIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YViUSZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NZAAAAAAAAAAAAAAAAAAAAAAAAAAAAEHBxcnN0dXZ3eHl6e3x9fn-lAQIDJiABIVggju1_zMWWXW1dd6_hPeNQsD8zHubFfsYvrytwVl9WbEAiWCDPQRIugte-61i9A4-5TK6laHPtjN35eAzS_eWGqeqyng
expect: webauthn: registered identity:[0-9a-f-]+
capture: uuid2 registered identity:([0-9a-f-]+)

# one copy asserts counter 7 (flags UP|BE|BS = 0x19)
cmd: webauthn authenticate BgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgY cHFyc3R1dnd4eXp7fH1-fw eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiQmdZR0JnWUdCZ1lHQmdZR0JnWUdCZ1lHQmdZR0JnWUdCZ1lHQmdZR0JnWSIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MZAAAABw MEQCIDfVGCeTaCNlcjZqJLe1BqNxJWKQamEL67h5yOetJ_kLAiBxgd4ZK45rlRZjOuw1XvEvyCJYKFjo9ZrArT6954pk3A
expect: webauthn: authenticated identity:%{uuid2} signCount 7 flags 0x19

# another copy still reports 0: backup-eligible is exempt from the
# strictly-increasing counter policy, so this is accepted, not a
# permanent lockout
cmd: webauthn authenticate BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc cHFyc3R1dnd4eXp7fH1-fw eyJ0eXBlIjoid2ViYXV0aG4uZ2V0IiwiY2hhbGxlbmdlIjoiQndjSEJ3Y0hCd2NIQndjSEJ3Y0hCd2NIQndjSEJ3Y0hCd2NIQndjSEJ3YyIsIm9yaWdpbiI6Imh0dHBzOi8vbG9jYWxob3N0Ojg0NDMiLCJjcm9zc09yaWdpbiI6ZmFsc2V9 SZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2MZAAAAAA MEUCIG7SQfzugLhWvIKMODo3IFTStVzJaWZsdOngDj1A9_4jAiEAuTVeXBA7oGXQQcT1OdbGzLf8A8TYZODjjukiOYuuB1s
expect: webauthn: authenticated identity:%{uuid2} signCount 0 flags 0x19

# the System-tier API refuses a console caller
cmd: code "/usr/System/sys/webauthnd"->issue_challenge()
expect: Error: Access denied

# the record carries the passkey row with the advanced counter
cmd: identity show %{uuid}
expect: credentials: 1
expect: passkey signCount 6
